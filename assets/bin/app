#!/usr/bin/env python3
# app - The TrashcanOS Package Manager Wrapper
# 🍌 TrashcanOS: Chaos Verified.

import sys
import subprocess
import difflib
import time
import threading
import os

# 🌸 Configuration 🌸
CONTAINER_NAME = "trashcan-box"
LOG_FILE = "/tmp/trashcan_app_log.txt"

# 🎨 Color Palette 🎨
GREEN = '\033[0;32m'
BLUE = '\033[0;34m'
YELLOW = '\033[1;33m'
RED = '\033[0;31m'
NC = '\033[0m'

def aesthetic_spinner(event, message):
    """The clean, zero-bloat spinner."""
    chars = ['✨', '🌟', '💫', '⭐', '🌠']
    i = 0
    # Hide cursor
    sys.stdout.write('\033[?25l')
    while not event.is_set():
        sys.stdout.write(f"\r{BLUE}{chars[i]} {message}...{NC}  ")
        sys.stdout.flush()
        time.sleep(0.2)
        i = (i + 1) % len(chars)
    # Clear line and show cursor
    sys.stdout.write("\r\033[K\033[?25h")
    sys.stdout.flush()

def run_quiet(cmd, message):
    """Runs a process silently while spinning, logs output to file."""
    event = threading.Event()
    thread = threading.Thread(target=aesthetic_spinner, args=(event, message))
    thread.start()
    
    with open(LOG_FILE, "a") as log:
        log.write(f"\n--- Running: {cmd} ---\n")
        process = subprocess.run(cmd, shell=True, stdout=log, stderr=subprocess.STDOUT, text=True)
    
    event.set()
    thread.join()
    return process

def run_capture(cmd):
    """Runs a process quietly but returns the output for us to analyze."""
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

def ensure_container():
    """Checks if the container exists and is alive, just like your bash script!"""
    check_exists = run_capture(f"podman container exists {CONTAINER_NAME}")
    
    if check_exists.returncode != 0:
        print(f"{GREEN}📦 Initializing the App Environment (First run only)...{NC}")
        run_quiet(f"distrobox create -n {CONTAINER_NAME} -i quay.io/fedora/fedora:latest -Y", "Creating container")
        run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- true", "Setting up container internals")
        return

    check_alive = run_capture(f"distrobox enter -T {CONTAINER_NAME} -- true")
    if check_alive.returncode != 0:
        print(f"{RED}⚠️  Detected corrupted App Environment!{NC}")
        print(f"{YELLOW}♻️  Rebuilding trashcan-box...{NC}")
        run_quiet(f"distrobox rm {CONTAINER_NAME} --force", "Nuking corrupted container")
        run_quiet(f"distrobox create -n {CONTAINER_NAME} -i quay.io/fedora/fedora:latest -Y", "Recreating container")
        run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- true", "Initializing container")

def show_help():
    print(f"🗑️  {GREEN}TrashcanOS App Manager{NC}")
    print("Usage:")
    print("  app install <package|file>   Search & Install (Flatpak -> DNF Fallback)")
    print("  app remove <package>         Remove an app")
    print("  app update [package]         Update apps only (DNF)")
    print("  app upgrade [package]        Update System (Bootc) + Apps (DNF)")
    print("  app full-upgrade             Force update EVERYTHING (Flatpak, DNF, Bootc, OSTree)")
    print("  app list                     List installed apps")

def install_app(target):
    # Check for local Flatpak files
    if target.endswith((".flatpakref", ".flatpak")):
        print(f"{GREEN}📦 Detected Flatpak file. Installing to System (User)...{NC}")
        res = run_quiet(f"flatpak install -y {target}", "Installing local Flatpak")
        if res.returncode == 0:
            print(f"{GREEN}✅ Flatpak installed!{NC}")
        else:
            print(f"{RED}❌ Failed. Check {LOG_FILE}{NC}")
        return

    ensure_container()

    # Check if already installed in container
    is_installed = run_capture(f"distrobox enter -T {CONTAINER_NAME} -- rpm -q {target}")
    if is_installed.returncode == 0:
        print(f"{YELLOW}⚠️  '{target}' is already installed.{NC}")
        print(f"Did you mean to update it? Run: {GREEN}app update {target}{NC}")
        return

    # Check for local RPM
    if target.endswith(".rpm"):
        if os.path.isfile(target):
            print(f"{GREEN}📦 Detected local RPM file. Installing in container...{NC}")
            abs_path = os.path.abspath(target)
            res = run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf install -y {abs_path}", "Installing RPM")
            if res.returncode == 0:
                run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- distrobox-export --app {target}", "Exporting shortcut")
                print(f"{GREEN}✅ Installation complete!{NC}")
            else:
                print(f"{RED}❌ Installation FAILED. Check {LOG_FILE}{NC}")
        else:
            print(f"{RED}Error: File '{target}' not found.{NC}")
        return

    # --- THE PIPELINE: Flatpak -> DNF ---
    print(f"{GREEN}🔍 Searching Flatpak for '{target}'...{NC}")
    flat_search = run_capture(f"flatpak search {target} --columns=application,name")
    
    if flat_search.stdout.strip():
        print(f"{YELLOW}💡 Found these on Flatpak:{NC}")
        lines = flat_search.stdout.strip().split('\n')[:5]
        for line in lines:
            print(f"   {line}")
        
        choice = input(f"\n{BLUE}Copy the exact Application ID to install (or press Enter for DNF): {NC}").strip()
        if choice:
            res = run_quiet(f"flatpak install -y flathub {choice}", f"Installing {choice}")
            if res.returncode == 0:
                print(f"{GREEN}✅ {choice} installed perfectly!{NC}")
            else:
                print(f"{RED}❌ Flatpak install failed. Check {LOG_FILE}{NC}")
            return

    # Fallback to DNF
    print(f"{YELLOW}⚠️  Moving to Container ({CONTAINER_NAME}) DNF fallback...{NC}")
    
    event = threading.Event()
    thread = threading.Thread(target=aesthetic_spinner, args=(event, f"Searching DNF for {target}"))
    thread.start()
    dnf_search = run_capture(f"distrobox enter -T {CONTAINER_NAME} -- dnf search {target}")
    event.set()
    thread.join()

    if "No matches found" in dnf_search.stdout or dnf_search.returncode != 0:
        print(f"{RED}❌ Bestie, I literally couldn't find '{target}' anywhere. Check your spelling!{NC}")
        return

    print(f"{YELLOW}💡 Found these close matches in DNF:{NC}")
    # Filter out the noisy metadata text
    clean_lines = [line for line in dnf_search.stdout.split('\n') if "Last metadata expiration" not in line and "matched:" not in line and line.strip()]
    for line in clean_lines[:8]:
        print(f"   {line}")
        
    dnf_pkg = input(f"\n{BLUE}Enter the exact package name to install (or press Enter to cancel): {NC}").strip()
    
    if dnf_pkg:
        res = run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf install -y {dnf_pkg}", f"Installing {dnf_pkg} via DNF")
        if res.returncode == 0:
            run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- distrobox-export --app {dnf_pkg}", "Exporting to host menu")
            print(f"{GREEN}✅ {dnf_pkg} installed successfully!{NC}")
        else:
            print(f"{RED}❌ DNF install failed. Check {LOG_FILE}{NC}")
    else:
        print(f"{RED}❌ Installation cancelled.{NC}")

def main():
    if len(sys.argv) < 2:
        show_help()
        sys.exit(1)

    command = sys.argv[1]
    target = sys.argv[2] if len(sys.argv) > 2 else ""

    if command == "install":
        if not target:
            print(f"{RED}Error: You must specify a package name or file.{NC}")
            sys.exit(1)
        install_app(target)

    elif command == "remove":
        if not target:
            print(f"{RED}Error: What do you want to remove?{NC}")
            sys.exit(1)
        ensure_container()
        run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- distrobox-export --delete {target}", "Cleaning up shortcuts")
        run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf remove -y {target}", f"Removing {target}")
        print(f"{GREEN}🗑️  {target} has been completely wiped.{NC}")

    elif command == "update":
        ensure_container()
        if not target:
            run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf upgrade --refresh -y", "Updating all Container Apps")
            print(f"{GREEN}✅ All apps updated.{NC}")
        else:
            run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf upgrade --refresh -y {target}", f"Updating {target}")
            print(f"{GREEN}✅ Update complete.{NC}")

    elif command == "upgrade":
        ensure_container()
        if not target:
            print(f"{BLUE}============ 1/2: UPDATING APPS ============{NC}")
            run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf upgrade --refresh -y", "Running DNF upgrade")
            print(f"{BLUE}============ 2/2: UPDATING SYSTEM (Bootc) ============{NC}")
            run_quiet("sudo /usr/bin/bootc upgrade", "Upgrading TrashcanOS Core")
            print(f"{GREEN}✅ System & App Upgrade Complete.{NC}")
        else:
            run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf upgrade --refresh -y {target}", f"Updating {target}")
            print(f"{GREEN}✅ Package upgraded.{NC}")

    elif command == "full-upgrade":
        if target:
            print(f"{RED}Error: 'full-upgrade' does not accept package names. It updates EVERYTHING.{NC}")
            sys.exit(1)
        
        print(f"{RED}⚠️  WARNING: Performing a FULL SYSTEM overhaul{NC}")
        print(f"{BLUE}📦 [1/4] Updating Flatpaks...{NC}")
        run_quiet("flatpak update -y", "Updating Flatpak environment")
        
        print(f"{BLUE}🧊 [2/4] Updating Container Apps...{NC}")
        ensure_container()
        run_quiet(f"distrobox enter -T {CONTAINER_NAME} -- sudo dnf upgrade --refresh -y", "Updating Container DNF")
        
        print(f"{BLUE}💿 [3/4] Updating TrashcanOS Core...{NC}")
        run_quiet("sudo /usr/bin/bootc upgrade", "Upgrading via Bootc")
        
        print(f"{BLUE}🛡️  [4/4] Updating Layered Drivers...{NC}")
        run_quiet("sudo /usr/bin/rpm-ostree upgrade", "Upgrading RPM-OSTree layers")
        
        print(f"{GREEN}✅ FULL SYSTEM UPGRADE COMPLETE!{NC}")
        print(f"{YELLOW}ℹ️  Please reboot to apply the OS Core updates!{NC}")

    elif command == "list":
        ensure_container()
        subprocess.run(f"distrobox enter -T {CONTAINER_NAME} -- dnf list installed --userinstalled", shell=True)

    else:
        show_help()

if __name__ == "__main__":
    main()